                <text><![CDATA[Curso]]></text>
            </staticText>

            <staticText>
                <reportElement x="210" y="0" width="115" height="26" uuid="bbbbbbbb-bbbb-4bbb-bbbb-bbbbbbbbbbb3"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#9DB4E8"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
