<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="relatorio_professor" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8af63066-0c0d-412e-9ae4-c87a0bdf4e64">
	<parameter name="idProfessor" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    c.nome AS curso,
    u.nome AS aluno,
    i.data_inscricao AS data_inscricao,
    COUNT(a.id_aula) AS total_aulas,
    COALESCE(n.nota, 0) AS nota
FROM cursos c
INNER JOIN inscricoes i ON c.id_curso = i.id_curso
INNER JOIN usuarios u ON i.id_usuario = u.id_usuario
LEFT JOIN aulas a ON c.id_curso = a.id_curso
LEFT JOIN notas n
    ON n.id_usuario = i.id_usuario
   AND n.id_curso = c.id_curso
WHERE c.id_professor = $P{idProfessor}
GROUP BY
    c.id_curso,
    c.nome,
    u.nome,
    i.data_inscricao,
    n.nota
ORDER BY c.nome, u.nome]]>
	</queryString>
	<field name="curso" class="java.lang.String"/>
	<field name="aluno" class="java.lang.String"/>
	<field name="data_inscricao" class="java.sql.Date"/>
	<field name="total_aulas" class="java.lang.Long"/>
	<field name="nota" class="java.lang.Double"/>
