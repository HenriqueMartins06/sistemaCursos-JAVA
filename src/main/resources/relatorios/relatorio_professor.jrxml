<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="relatorio_professor"
              pageWidth="595"
              pageHeight="842"
              whenNoDataType="AllSectionsNoDetail"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20"
              uuid="c7a30ed4-0f59-4dbb-8fcb-8a777ee11b22">

    <parameter name="idProfessor" class="java.lang.Integer"/>
    <parameter name="nomeProfessor" class="java.lang.String"/>

    <queryString language="SQL">
        <![CDATA[
SELECT
    c.nome AS curso,

    (SELECT COUNT(*)
     FROM inscricoes i
     WHERE i.id_curso = c.id_curso) AS total_alunos,

    (SELECT COUNT(*)
     FROM aulas a
     WHERE a.id_curso = c.id_curso) AS total_aulas,

    (SELECT AVG(n.nota)
     FROM notas n
     WHERE n.id_curso = c.id_curso) AS media_turma

FROM cursos c
WHERE c.id_professor = $P{idProfessor}
ORDER BY c.nome
        ]]>
    </queryString>

    <field name="curso" class="java.lang.String"/>
    <field name="total_alunos" class="java.lang.Long"/>
    <field name="total_aulas" class="java.lang.Long"/>
    <field name="media_turma" class="java.lang.Double"/>

    <title>
        <band height="118">
            <rectangle>
                <reportElement mode="Opaque" x="0" y="0" width="555" height="58" backcolor="#1E3A8A" uuid="aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaa1"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement forecolor="#FFFFFF" x="20" y="10" width="515" height="25" uuid="aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaa2"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="17" isBold="true"/>
                </textElement>
                <text><![CDATA[RELATÓRIO GERAL DAS TURMAS]]></text>
            </staticText>

            <staticText>
                <reportElement forecolor="#DDE7FF" x="20" y="34" width="515" height="16" uuid="aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaa3"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <text><![CDATA[Cursos, alunos inscritos, total de aulas e média da turma]]></text>
            </staticText>

            <rectangle>
                <reportElement mode="Opaque" x="0" y="70" width="555" height="32" backcolor="#F4F7FF" uuid="aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaa4"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#D6E2FF"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="14" y="78" width="65" height="16" uuid="aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaa5"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Professor:]]></text>
            </staticText>

            <textField>
                <reportElement x="80" y="78" width="245" height="16" uuid="aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaa6"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{nomeProfessor} == null ? "Não informado" : $P{nomeProfessor}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="350" y="78" width="92" height="16" uuid="aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaa7"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Data de emissão:]]></text>
            </staticText>

            <textField>
                <reportElement x="443" y="78" width="95" height="16" uuid="aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaa8"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.text.SimpleDateFormat("dd/MM/yyyy").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="30">
            <rectangle>
                <reportElement mode="Opaque" x="0" y="0" width="555" height="26" backcolor="#EAF1FF" uuid="bbbbbbbb-bbbb-4bbb-bbbb-bbbbbbbbbbb1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#9DB4E8"/>
