                </textElement>
                <text><![CDATA[Total de aulas]]></text>
            </staticText>

            <staticText>
                <reportElement x="435" y="0" width="120" height="26" uuid="bbbbbbbb-bbbb-4bbb-bbbb-bbbbbbbbbbb5"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#9DB4E8"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Média da turma]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="28">
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="210" height="26" uuid="cccccccc-cccc-4ccc-cccc-ccccccccccc1"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#D6E2FF"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                    <paragraph leftIndent="4"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{curso}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="210" y="0" width="115" height="26" uuid="cccccccc-cccc-4ccc-cccc-ccccccccccc2"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#D6E2FF"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{total_alunos}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="325" y="0" width="110" height="26" uuid="cccccccc-cccc-4ccc-cccc-ccccccccccc3"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#D6E2FF"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{total_aulas}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="435" y="0" width="120" height="26" uuid="cccccccc-cccc-4ccc-cccc-ccccccccccc4"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#D6E2FF"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{media_turma} == null ? "-" : String.format(new java.util.Locale("pt", "BR"), "%.2f", $F{media_turma})]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="25">
