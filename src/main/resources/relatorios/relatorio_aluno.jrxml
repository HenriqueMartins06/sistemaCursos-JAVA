<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="relatorio_aluno"
              pageWidth="595"
              pageHeight="842"
              whenNoDataType="AllSectionsNoDetail"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20"
              uuid="290fff06-500a-4ebf-b53a-80f39d8cc67c">

    <parameter name="idAluno" class="java.lang.Integer"/>
    <parameter name="nomeAluno" class="java.lang.String"/>

    <queryString language="SQL">
        <![CDATA[
SELECT
    c.nome AS curso,
    p.nome AS professor,
    i.data_inscricao AS data_inscricao,
    COUNT(a.id_aula) AS total_aulas,
    n.nota AS nota,
    CASE
        WHEN n.nota IS NULL THEN 'Sem nota'
        WHEN n.nota >= 6 THEN 'Aprovado'
        ELSE 'Reprovado'
    END AS situacao
FROM inscricoes i
INNER JOIN cursos c ON i.id_curso = c.id_curso
INNER JOIN usuarios p ON c.id_professor = p.id_usuario
LEFT JOIN aulas a ON c.id_curso = a.id_curso
LEFT JOIN notas n
    ON n.id_usuario = i.id_usuario
   AND n.id_curso = i.id_curso
WHERE i.id_usuario = $P{idAluno}
GROUP BY
    c.id_curso,
    c.nome,
    p.nome,
    i.data_inscricao,
    n.nota
ORDER BY c.nome
        ]]>
    </queryString>

    <field name="curso" class="java.lang.String"/>
    <field name="professor" class="java.lang.String"/>
    <field name="data_inscricao" class="java.sql.Date"/>
    <field name="total_aulas" class="java.lang.Long"/>
    <field name="nota" class="java.lang.Double"/>
    <field name="situacao" class="java.lang.String"/>

